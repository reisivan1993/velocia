{
  "$id": "urn:velocia:schema:hardware-profile:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``hardware/<name>.yaml``: per-node facts that hardware probes cannot observe.",
  "properties": {
    "accelerator_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Accelerator model, recorded as declared.",
      "title": "Accelerator Model"
    },
    "accelerators_per_node": {
      "default": 0,
      "description": "Accelerator devices per node (for `accelerator_hours`).",
      "minimum": 0,
      "title": "Accelerators Per Node",
      "type": "integer"
    },
    "custom": {
      "default": {},
      "description": "Coefficients for formula measures, available as `hw.<key>`.",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "number"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Custom",
      "type": "object"
    },
    "name": {
      "description": "Profile name (the file name in `hardware_dir`).",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "price_per_node_hour_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Price of one node for one hour (for `cost_usd`).",
      "title": "Price Per Node Hour Usd"
    },
    "watts_per_node": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Power draw per node (for `energy_kwh`, an estimate).",
      "title": "Watts Per Node"
    }
  },
  "required": [
    "name"
  ],
  "title": "HardwareProfile",
  "type": "object"
}
