{
  "$id": "urn:velocia:schema:engine:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``engines/<name>.yaml``.",
  "properties": {
    "family": {
      "default": "spark",
      "description": "Engine family (only `spark`).",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Family",
      "type": "string"
    },
    "image": {
      "description": "Container image, ideally pinned by digest.",
      "minLength": 1,
      "title": "Image",
      "type": "string"
    },
    "name": {
      "description": "Engine name used in experiments.",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Free text shown in manifests.",
      "title": "Notes"
    },
    "platforms": {
      "default": [],
      "description": "Docker platforms the image runs on natively; empty means any.",
      "items": {
        "type": "string"
      },
      "title": "Platforms",
      "type": "array"
    },
    "spark_conf": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Spark settings the engine needs (plugins, memory, ...).",
      "title": "Spark Conf",
      "type": "object"
    },
    "spark_versions": {
      "description": "Apache Spark versions the engine supports.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Spark Versions",
      "type": "array"
    }
  },
  "required": [
    "name",
    "image",
    "spark_versions"
  ],
  "title": "EngineDef",
  "type": "object"
}
