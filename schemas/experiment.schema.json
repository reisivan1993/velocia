{
  "$defs": {
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "allow_cross_hardware": {
          "default": false,
          "description": "Allow engines on different hardware; needs a normalized measure (cost, node-hours, ...).",
          "title": "Allow Cross Hardware",
          "type": "boolean"
        }
      },
      "title": "Comparison",
      "type": "object"
    },
    "CustomJob": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "description": "Jar only: program arguments; `${table:<name>}` becomes the table's path.",
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "artifact": {
          "description": "A `.py`, `.zip` or `.jar`, relative to the experiment file.",
          "title": "Artifact",
          "type": "string"
        },
        "entrypoint": {
          "description": "`module:function` (Python) or the main class (jar).",
          "title": "Entrypoint",
          "type": "string"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python only: `module:function` returning rows and checksum per unit.",
          "title": "Validator"
        }
      },
      "required": [
        "artifact",
        "entrypoint"
      ],
      "title": "CustomJob",
      "type": "object"
    },
    "DataFormat": {
      "enum": [
        "parquet-snappy",
        "parquet-zstd"
      ],
      "title": "DataFormat",
      "type": "string"
    },
    "EngineRef": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cluster (from `clusters`) the engine runs on.",
          "title": "Cluster"
        },
        "name": {
          "description": "Engine name.",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EngineRef",
      "type": "object"
    },
    "ExternalCluster": {
      "additionalProperties": false,
      "properties": {
        "data_uri": {
          "description": "Storage the executors read (`s3a://`, `hdfs://`, `file://`); datasets are copied there.",
          "title": "Data Uri",
          "type": "string"
        },
        "deploy_mode": {
          "default": "client",
          "description": "Only `client` so far: the driver runs on this machine.",
          "enum": [
            "client",
            "cluster"
          ],
          "title": "Deploy Mode",
          "type": "string"
        },
        "docker_args": {
          "default": [],
          "description": "Extra `docker run` arguments for the submitting container.",
          "items": {
            "type": "string"
          },
          "title": "Docker Args",
          "type": "array"
        },
        "docker_network": {
          "default": "host",
          "description": "Docker network of the submitting container.",
          "title": "Docker Network",
          "type": "string"
        },
        "driver_memory": {
          "default": "2g",
          "description": "Driver memory, e.g. `2g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Driver Memory",
          "type": "string"
        },
        "eventlog_uri": {
          "description": "Where Spark writes event logs; Velocia copies them back.",
          "title": "Eventlog Uri",
          "type": "string"
        },
        "executor_cores": {
          "description": "Cores per executor.",
          "minimum": 1,
          "title": "Executor Cores",
          "type": "integer"
        },
        "executor_memory": {
          "description": "Memory per executor, e.g. `4g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Executor Memory",
          "type": "string"
        },
        "executors": {
          "description": "Executors (local: multiplied by `executor_cores` for local[N]).",
          "minimum": 1,
          "title": "Executors",
          "type": "integer"
        },
        "hardware_profile": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hardware profile name (file in `hardware_dir`) describing the nodes.",
          "title": "Hardware Profile"
        },
        "master": {
          "description": "Spark master URL, e.g. `spark://host:7077`.",
          "title": "Master",
          "type": "string"
        },
        "rest_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The master's web UI, for the quiet check.",
          "title": "Rest Url"
        },
        "runner": {
          "const": "external",
          "description": "`local` (Docker), `k8s` or `external` (a cluster Velocia doesn't manage).",
          "title": "Runner",
          "type": "string"
        },
        "spark_home": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Submit with the Spark install here instead of the engine image in Docker.",
          "title": "Spark Home"
        },
        "submit_args": {
          "default": [],
          "description": "Extra spark-submit arguments, e.g. `--packages` or `--conf` for storage.",
          "items": {
            "type": "string"
          },
          "title": "Submit Args",
          "type": "array"
        }
      },
      "required": [
        "executors",
        "executor_cores",
        "executor_memory",
        "runner",
        "master",
        "data_uri",
        "eventlog_uri"
      ],
      "title": "ExternalCluster",
      "type": "object"
    },
    "K8sCluster": {
      "additionalProperties": false,
      "properties": {
        "driver_memory": {
          "default": "2g",
          "description": "Driver memory, e.g. `2g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Driver Memory",
          "type": "string"
        },
        "executor_cores": {
          "description": "Cores per executor.",
          "minimum": 1,
          "title": "Executor Cores",
          "type": "integer"
        },
        "executor_memory": {
          "description": "Memory per executor, e.g. `4g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Executor Memory",
          "type": "string"
        },
        "executors": {
          "description": "Executors (local: multiplied by `executor_cores` for local[N]).",
          "minimum": 1,
          "title": "Executors",
          "type": "integer"
        },
        "hardware_profile": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hardware profile name (file in `hardware_dir`) describing the nodes.",
          "title": "Hardware Profile"
        },
        "namespace": {
          "default": "default",
          "description": "Kubernetes namespace.",
          "title": "Namespace",
          "type": "string"
        },
        "node_selector": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Node labels the pods must match.",
          "title": "Node Selector",
          "type": "object"
        },
        "resources": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "description": "Extended resources per executor, e.g. accelerator devices.",
          "title": "Resources",
          "type": "object"
        },
        "runner": {
          "const": "k8s",
          "description": "`local` (Docker), `k8s` or `external` (a cluster Velocia doesn't manage).",
          "title": "Runner",
          "type": "string"
        },
        "tolerations": {
          "default": [],
          "description": "Pod tolerations.",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Tolerations",
          "type": "array"
        }
      },
      "required": [
        "executors",
        "executor_cores",
        "executor_memory",
        "runner"
      ],
      "title": "K8sCluster",
      "type": "object"
    },
    "KeyDistribution": {
      "enum": [
        "uniform",
        "zipf",
        "hotkey"
      ],
      "title": "KeyDistribution",
      "type": "string"
    },
    "LocalCluster": {
      "additionalProperties": false,
      "properties": {
        "driver_memory": {
          "default": "2g",
          "description": "Driver memory, e.g. `2g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Driver Memory",
          "type": "string"
        },
        "executor_cores": {
          "description": "Cores per executor.",
          "minimum": 1,
          "title": "Executor Cores",
          "type": "integer"
        },
        "executor_memory": {
          "description": "Memory per executor, e.g. `4g`.",
          "pattern": "^[1-9][0-9]*[kmgt]$",
          "title": "Executor Memory",
          "type": "string"
        },
        "executors": {
          "description": "Executors (local: multiplied by `executor_cores` for local[N]).",
          "minimum": 1,
          "title": "Executors",
          "type": "integer"
        },
        "hardware_profile": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hardware profile name (file in `hardware_dir`) describing the nodes.",
          "title": "Hardware Profile"
        },
        "runner": {
          "const": "local",
          "description": "`local` (Docker), `k8s` or `external` (a cluster Velocia doesn't manage).",
          "title": "Runner",
          "type": "string"
        }
      },
      "required": [
        "executors",
        "executor_cores",
        "executor_memory",
        "runner"
      ],
      "title": "LocalCluster",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "cold",
        "warm"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Suite": {
      "enum": [
        "tpch",
        "tpcds",
        "tera",
        "text",
        "graph",
        "kmeans",
        "etl",
        "synth",
        "custom"
      ],
      "title": "Suite",
      "type": "string"
    },
    "SynthSpec": {
      "additionalProperties": false,
      "description": "Seeded edge-case data (docs/03-spec.md \u00a71.3, \u00a72): ``synth.yaml`` or ``workload.synth``.\n\nTwo tables: ``fact`` (``rows`` rows: ``key``, ``payload_columns`` longs ``p0``.., a string\n``s``) and ``dim`` (one row per key). Every field can be swept (``workload.sweep``).",
      "properties": {
        "files": {
          "default": 8,
          "description": "files per table",
          "maximum": 100000,
          "minimum": 1,
          "title": "Files",
          "type": "integer"
        },
        "hot_fraction": {
          "default": 0.1,
          "description": "share of rows on key 0 (key_dist: hotkey)",
          "maximum": 1,
          "minimum": 0,
          "title": "Hot Fraction",
          "type": "number"
        },
        "key_dist": {
          "$ref": "#/$defs/KeyDistribution",
          "default": "uniform",
          "description": "Key distribution: uniform, zipf or hotkey."
        },
        "keys": {
          "default": 100000,
          "description": "key cardinality; dim has one row per key",
          "exclusiveMinimum": 0,
          "title": "Keys",
          "type": "integer"
        },
        "nest_fanout": {
          "default": 4,
          "description": "elements in nest.arr",
          "maximum": 1000,
          "minimum": 0,
          "title": "Nest Fanout",
          "type": "integer"
        },
        "null_fraction": {
          "default": 0.0,
          "description": "per payload column",
          "maximum": 1,
          "minimum": 0,
          "title": "Null Fraction",
          "type": "number"
        },
        "payload_columns": {
          "default": 4,
          "description": "Number of long columns `p0`.. (wide rows).",
          "maximum": 2000,
          "minimum": 1,
          "title": "Payload Columns",
          "type": "integer"
        },
        "rows": {
          "default": 1000000,
          "description": "Rows in `fact`.",
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "description": "Generator seed: the same spec and seed give the same data.",
          "title": "Seed",
          "type": "integer"
        },
        "selectivity": {
          "default": 0.1,
          "description": "share of rows scan_filter keeps",
          "maximum": 1,
          "minimum": 0,
          "title": "Selectivity",
          "type": "number"
        },
        "string_length": {
          "default": 16,
          "description": "mean length of column s",
          "maximum": 10000,
          "minimum": 0,
          "title": "String Length",
          "type": "integer"
        },
        "window_frame": {
          "default": 10,
          "description": "rows preceding in window",
          "maximum": 100000,
          "minimum": 0,
          "title": "Window Frame",
          "type": "integer"
        },
        "zipf_s": {
          "default": 1.0,
          "description": "Zipf exponent (key_dist: zipf)",
          "maximum": 3,
          "minimum": 0,
          "title": "Zipf S",
          "type": "number"
        }
      },
      "title": "SynthSpec",
      "type": "object"
    },
    "Workload": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use this generated dataset instead of one derived from the fields above.",
          "title": "Dataset Id"
        },
        "format": {
          "$ref": "#/$defs/DataFormat",
          "default": "parquet-zstd",
          "description": "Data file format."
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomJob"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom job (Python or jar)."
        },
        "kind": {
          "$ref": "#/$defs/WorkloadKind",
          "description": "`sql` (queries) or `job` (job units)."
        },
        "rows": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Size of a generated job dataset (records, lines, edges or points).",
          "title": "Rows"
        },
        "scale_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TPC-H/TPC-DS-derived scale factor.",
          "title": "Scale Factor"
        },
        "sql_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom SQL: a directory of `<unit>.sql` files, relative to the experiment file.",
          "title": "Sql Dir"
        },
        "suite": {
          "$ref": "#/$defs/Suite",
          "description": "Which workload: tpch, tpcds, tera, text, etl, graph, kmeans, synth or custom."
        },
        "sweep": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Synth parameters to sweep: each value is its own cell (and dataset).",
          "title": "Sweep"
        },
        "synth": {
          "anyOf": [
            {
              "$ref": "#/$defs/SynthSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Synth generator settings (synth suite only)."
        },
        "units": {
          "anyOf": [
            {
              "const": "all",
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "default": "all",
          "description": "`all`, or the units to run.",
          "title": "Units"
        }
      },
      "required": [
        "kind",
        "suite"
      ],
      "title": "Workload",
      "type": "object"
    },
    "WorkloadKind": {
      "enum": [
        "sql",
        "job"
      ],
      "title": "WorkloadKind",
      "type": "string"
    }
  },
  "$id": "urn:velocia:schema:experiment:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An experiment file (docs/04-interfaces.md \u00a73).",
  "properties": {
    "cluster": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "external": "#/$defs/ExternalCluster",
              "k8s": "#/$defs/K8sCluster",
              "local": "#/$defs/LocalCluster"
            },
            "propertyName": "runner"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalCluster"
            },
            {
              "$ref": "#/$defs/K8sCluster"
            },
            {
              "$ref": "#/$defs/ExternalCluster"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One cluster for every engine (or use `clusters`).",
      "title": "Cluster"
    },
    "clusters": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z0-9][a-z0-9_.-]*$": {
              "discriminator": {
                "mapping": {
                  "external": "#/$defs/ExternalCluster",
                  "k8s": "#/$defs/K8sCluster",
                  "local": "#/$defs/LocalCluster"
                },
                "propertyName": "runner"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LocalCluster"
                },
                {
                  "$ref": "#/$defs/K8sCluster"
                },
                {
                  "$ref": "#/$defs/ExternalCluster"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Named clusters; each engine names its cluster.",
      "title": "Clusters"
    },
    "comparison": {
      "$ref": "#/$defs/Comparison",
      "default": {
        "allow_cross_hardware": false
      },
      "description": "Rules for comparing across hardware."
    },
    "engines": {
      "description": "Engines to compare: names, or `{name, cluster}` with several clusters.",
      "items": {
        "oneOf": [
          {
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          {
            "$ref": "#/$defs/EngineRef"
          }
        ]
      },
      "minItems": 1,
      "title": "Engines",
      "type": "array"
    },
    "measures": {
      "default": [
        "wall_time",
        "task_cpu_time"
      ],
      "description": "Measures to compute; the first one is the headline.",
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9_.-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Measures",
      "type": "array"
    },
    "modes": {
      "default": [
        "cold",
        "warm"
      ],
      "description": "`cold` (fresh application per repetition) and/or `warm` (one application, one discarded warm-up).",
      "items": {
        "$ref": "#/$defs/Mode"
      },
      "minItems": 1,
      "title": "Modes",
      "type": "array"
    },
    "name": {
      "description": "Experiment name; results are `<name>-<timestamp>`, and history groups by it.",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "price_table": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z0-9][a-z0-9_.-]*$": {
              "type": "number"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "USD per node-hour by hardware profile name; overrides the profiles' prices for `cost_usd`.",
      "title": "Price Table"
    },
    "reference_engine": {
      "description": "The engine every ratio and correctness check is relative to.",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Reference Engine",
      "type": "string"
    },
    "repetitions": {
      "default": 5,
      "description": "Timed repetitions per cell (5 or more recommended).",
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "spark_conf": {
      "additionalProperties": {
        "oneOf": [
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        ]
      },
      "default": {},
      "description": "Spark settings for every engine; a list sweeps the setting.",
      "title": "Spark Conf",
      "type": "object"
    },
    "timeout_per_unit": {
      "default": "30m",
      "description": "Per-unit time limit, e.g. `30m`; timed-out units are reported.",
      "pattern": "^[1-9][0-9]*(s|m|h)$",
      "title": "Timeout Per Unit",
      "type": "string"
    },
    "workload": {
      "$ref": "#/$defs/Workload",
      "description": "What to run."
    }
  },
  "required": [
    "name",
    "workload",
    "engines",
    "reference_engine"
  ],
  "title": "Experiment",
  "type": "object"
}
