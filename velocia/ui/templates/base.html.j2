<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — Velocia</title>
<style>
:root {
  color-scheme: light;
  --surface: #fcfcfb; --surface-2: #f3f2ef; --border: #e2e1dc;
  --text: #0b0b0b; --text-2: #52514e; --muted: #7a7974; --link: #1f62b3;
  --series-1: #2a78d6; --series-2: #c2410c; --series-3: #7c3aed; --series-4: #0f766e;
  --ref: #52514e; --grid: #e2e1dc; --critical: #d03b3b; --good: #0ca30c;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --surface: #1a1a19; --surface-2: #242423; --border: #383835;
    --text: #f0efec; --text-2: #c3c2b7; --muted: #8f8e88; --link: #7cb2f0;
    --series-1: #3987e5; --series-2: #f97316; --series-3: #a78bfa; --series-4: #2dd4bf;
    --ref: #c3c2b7; --grid: #383835;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface: #1a1a19; --surface-2: #242423; --border: #383835;
  --text: #f0efec; --text-2: #c3c2b7; --muted: #8f8e88; --link: #7cb2f0;
  --series-1: #3987e5; --series-2: #f97316; --series-3: #a78bfa; --series-4: #2dd4bf;
  --ref: #c3c2b7; --grid: #383835;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface); color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
header { border-bottom: 1px solid var(--border); }
header .in, main { max-width: 1040px; margin: 0 auto; padding: 12px 16px; }
header a { color: var(--text); font-weight: 650; text-decoration: none; }
main { padding-bottom: 64px; }
a { color: var(--link); }
h1 { font-size: 22px; margin: 16px 0 4px; }
h2 { font-size: 17px; margin: 28px 0 8px; }
.note { color: var(--text-2); font-size: 13px; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 8px 0; }
th, td { padding: 6px 8px; border-bottom: 1px solid var(--border); text-align: left;
  vertical-align: top; }
td.mono, code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
.status-done { color: var(--good); } .status-running, .status-failed { color: var(--critical); }
.fail { color: var(--critical); font-weight: 600; }
form { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; margin: 8px 0; }
label { display: flex; flex-direction: column; font-size: 13px; color: var(--text-2); gap: 2px; }
select, button { font: inherit; padding: 4px 8px; border: 1px solid var(--border);
  border-radius: 6px; background: var(--surface-2); color: var(--text); max-width: 100%; }
.chart { width: 100%; height: auto; max-width: 680px; display: block; margin: 8px 0; }
.chart text { font-size: 11px; fill: var(--text-2); }
.chart .tick { text-anchor: middle; fill: var(--muted); }
.chart .ytick { text-anchor: end; fill: var(--muted); }
.chart .grid { stroke: var(--grid); stroke-width: 1; }
.chart .ref { stroke: var(--ref); stroke-width: 1.5; stroke-dasharray: 3 3; }
.chart .fail { fill: var(--critical); font-size: 14px; text-anchor: middle; font-weight: 700; }
.sweep .line { fill: none; stroke-width: 2; }
.sweep .band { stroke: none; opacity: 0.16; }
.sweep .dot { stroke: var(--surface); stroke-width: 2; stroke-dasharray: none; }
.sweep .s1 { stroke: var(--series-1); } .sweep .band.s1, .sweep .dot.s1 { fill: var(--series-1); }
.sweep .s2 { stroke: var(--series-2); stroke-dasharray: 6 3; }
.sweep .band.s2, .sweep .dot.s2 { fill: var(--series-2); }
.sweep .s3 { stroke: var(--series-3); stroke-dasharray: 2 3; }
.sweep .band.s3, .sweep .dot.s3 { fill: var(--series-3); }
.sweep .s4 { stroke: var(--series-4); stroke-dasharray: 8 3 2 3; }
.sweep .band.s4, .sweep .dot.s4 { fill: var(--series-4); }
.sweep text.series-label { stroke: none; fill: var(--text); font-weight: 600; }
</style>
</head>
<body>
<header><div class="in"><a href="/">Velocia for Apache Spark</a>
  <span class="note"> · results viewer (read-only, this machine only)</span></div></header>
<main>
{{ body | safe }}
</main>
</body>
</html>
